# =============================================================
# Mugznlugz Portal — Environment Variables
# -------------------------------------------------------------
# Copy this file to `.env` and fill in the real values:
#     cp .env.example .env
#
# Then run `node build.js` to generate `config.js`.
# =============================================================

# --- Embedded website (Website panel) ---
SITE_URL=https://www.mugznlugz.com
FORCE_EMBED_FALLBACK=false
EMBED_TIMEOUT_MS=3500
EMBED_PREVIEW_URL=https://s.wordpress.com/mshots/v1/{url}?w=1280&h=800

# --- Local images (Gallery source) ---
# Images are automatically loaded from the images/ folder.
# Run `node build.js` after adding or removing images to regenerate config.js.
# Supported formats: .jpg, .jpeg, .png, .gif, .webp, .svg

# --- Demo images (Optional fallback) ---
# Comma-separated list of image URLs shown if no local images exist.
# Leave blank ( DEMO_IMAGES= ) to disable demo images.
DEMO_IMAGES=
